# ==============================================================================
# NexusAI-Client - Environment Configuration Template (.env)
# ==============================================================================
# Fill in your API keys below for each of the 9 supported AI providers.
# Providers with empty keys will be skipped during verification.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DeepSeek (Paid API)
# Get your API key at: https://platform.deepseek.com/api_keys
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 2. Google Gemini Pro (Paid Tier / High Throughput)
# Get your API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_PRO_API_KEY=your-gemini-pro-api-key
GEMINI_PRO_DEFAULT_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 3. Google Gemini Free (Free Tier via Google AI Studio)
# Get your API key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_FREE_API_KEY=your-google-ai-studio-api-key
# Generic fallback if using a single Google Gemini key:
# GEMINI_API_KEY=
GEMINI_FREE_DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Groq (Free Tier / Ultra-Fast LPU Acceleration)
# Get your API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 5. Cerebras (Free Tier / Wafer-Scale CS-3 Ultra-Fast Inference)
# Get your API key at: https://cloud.cerebras.ai/
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=csk-your-cerebras-api-key
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b

# ------------------------------------------------------------------------------
# 6. Cohere (Free Trial Tier / Enterprise Reasoning Models)
# Get your API key at: https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------------------------
COHERE_API_KEY=your-cohere-api-key
COHERE_DEFAULT_MODEL=command-r-plus-08-2024

# ------------------------------------------------------------------------------
# 7. Mistral AI (Free Tier / La Plateforme)
# Get your API key at: https://console.mistral.ai/api-keys/
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_DEFAULT_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 8. Nvidia NIM (Free Tier / 1,000 Inference Credits)
# Get your API key at: https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# 9. OpenRouter (Free Tier & Commercial Models)
# Get your API key at: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/NexusAI-Client
OPENROUTER_APP_NAME=NexusAI-Client

# ------------------------------------------------------------------------------
# Global Settings
# ------------------------------------------------------------------------------
NEXUS_DEFAULT_TIMEOUT=60.0
