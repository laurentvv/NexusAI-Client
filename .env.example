# ==============================================================================
# NexusAI-Client - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DeepSeek (API Payante)
# Obtenez votre clé sur : https://platform.deepseek.com/api_keys
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# 2. Google Gemini Pro (API Payante / Haute performance)
# Obtenez votre clé sur : https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_PRO_API_KEY=your-gemini-pro-api-key
GEMINI_PRO_DEFAULT_MODEL=gemini-2.5-pro

# ------------------------------------------------------------------------------
# 3. Google Gemini Free (Tier Gratuit via Google AI Studio)
# Obtenez votre clé sur : https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_FREE_API_KEY=your-gemini-free-api-key
# Note : GEMINI_API_KEY peut aussi être utilisé comme fallback générique pour Gemini
# GEMINI_API_KEY=your-generic-gemini-key
GEMINI_FREE_DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Mistral AI (Tier Gratuit / La Plateforme)
# Obtenez votre clé sur : https://console.mistral.ai/api-keys/
# ------------------------------------------------------------------------------
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_DEFAULT_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. Nvidia NIM (Tier Gratuit / 1000 crédits d'inférence)
# Obtenez votre clé sur : https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-your-nvidia-nim-key
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-8b-instruct

# ------------------------------------------------------------------------------
# 6. OpenRouter (Tier Gratuit & Modèles :free)
# Obtenez votre clé sur : https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://github.com/NexusAI-Client
OPENROUTER_APP_NAME=NexusAI-Client

# ------------------------------------------------------------------------------
# Paramètres Globaux
# ------------------------------------------------------------------------------
NEXUS_DEFAULT_TIMEOUT=60.0
